# Server-only Last.fm settings for the Spotify status. Never prefix these with VITE_.
LASTFM_API_KEY=
LASTFM_USERNAME=

# Required by deployed Vercel functions for a cache and cooldown shared across instances.
# Set both explicit Upstash values to override Vercel's KV_REST_API_URL and
# KV_REST_API_TOKEN pair. Partial explicit configuration is treated as missing.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local development uses preview playback by default. Set false with `bun run dev:spotify`
# to exercise the serverless endpoint using the credentials above.
VITE_SPOTIFY_USE_MOCK=true
